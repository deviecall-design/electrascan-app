# Browser — Vite exposes only VITE_ names to the client.
VITE_SUPABASE_URL=https://zxeznkuodpseijkvjwxa.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server — /api/detect and /api/estimates/create. ANTHROPIC_API_KEY must NOT use a VITE_ prefix.
SUPABASE_URL=https://zxeznkuodpseijkvjwxa.supabase.co
SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=

# Optional fallback while ANTHROPIC_API_KEY is unset. This key is shipped in the JS bundle.
VITE_ANTHROPIC_API_KEY=

# DocuSign — Send envelope fails closed until these are set.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URI=https://demo.docusign.net
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_PRIVATE_KEY=

# Xero (optional for the takeoff flow)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

# Vercel KV (QR session handoff only)
KV_REST_API_URL=
KV_REST_API_TOKEN=
